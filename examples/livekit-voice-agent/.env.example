# Copy to .env and fill in. `.env` is git-ignored; never commit real keys.

# --- LiveKit -----------------------------------------------------------------------------
# Local: `livekit-server --dev` listens on ws://localhost:7880 with the placeholder keys below.
# LiveKit Cloud: take all three from your project's Settings > Keys (URL looks like wss://xxx.livekit.cloud).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Speech to text: Deepgram -------------------------------------------------------------
DEEPGRAM_API_KEY=
# hi = Hindi model, transcribes Hinglish incl. English words (default). en / en-IN = English only. multi dropped Hindi in our test.
DEEPGRAM_LANGUAGE=hi

# --- LLM ------------------------------------------------------------------------------------
# anthropic (Claude, default) or openai. Only the chosen provider's key is needed.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, best answers) or claude-haiku-5-5 for the fastest first token.
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Text to speech: Vartaloop (https://tts.vartaloop.ai) ---------------------------------
VARTALOOP_API_KEY=
# sahil / saanvi speak Hinglish and Indian English; kiara / kevin are the English voices.
VARTALOOP_VOICE=sahil
# 0.5–2.0, pitch preserved. 1.1 is the showcase pace for sahil.
VARTALOOP_SPEED=1.1

# --- Hosting a public demo (all optional; defaults are right for a laptop) -------------------
# Only join rooms whose token asked for this agent (both processes must agree). Empty = auto-join.
# AGENT_NAME=vartaloop-demo
# Fernet key shared by token_server.py and agent.py for bring-your-own-key conversations:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AGENT_SHARED_SECRET=
# Refuse tokens without a caller key (every conversation is then metered to the caller).
# ALLOW_ANONYMOUS=false
# Page on another host than the token server:
# ALLOWED_ORIGINS=https://tts.vartaloop.ai
# TRUST_X_FORWARDED_FOR=true
# New conversations per client address per hour (0 = unlimited):
# TOKENS_PER_IP_PER_HOUR=10
# Hard cap per conversation in seconds (0 = unlimited):
# MAX_SESSION_SECONDS=180
# Mount the token routes under a prefix a load balancer forwards; skip serving web/:
# ROUTE_PREFIX=/integration/livekit
# SERVE_STATIC=false
# A Vartaloop server reachable on a private network instead of the public API:
# VARTALOOP_BASE_URL=https://api.vartaloop.ai

# --- Optional -----------------------------------------------------------------------------
# AGENT_INSTRUCTIONS=   # override the system prompt
# AGENT_GREETING=       # override the first thing the agent says
# TOKEN_SERVER_HOST=127.0.0.1
# TOKEN_SERVER_PORT=8080
# TOKEN_TTL_SECONDS=3600
